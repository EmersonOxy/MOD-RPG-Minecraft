diff --git a/src/main/java/nl/enjarai/doabarrelroll/util/OxyRpgCompat.java b/src/main/java/nl/enjarai/doabarrelroll/util/OxyRpgCompat.java
new file mode 100644
index 0000000..167b6d1
--- /dev/null
+++ b/src/main/java/nl/enjarai/doabarrelroll/util/OxyRpgCompat.java
@@ -0,0 +1,33 @@
+package nl.enjarai.doabarrelroll.util;
+
+import java.lang.reflect.Method;
+import net.minecraft.world.entity.LivingEntity;
+import net.neoforged.fml.ModList;
+import nl.enjarai.doabarrelroll.DoABarrelRoll;
+
+/** The Aviary skill owns paid thrust and its progression speed limits. */
+public final class OxyRpgCompat {
+    private static boolean resolved;
+    private static Method canFly;
+    private OxyRpgCompat() {}
+    public static boolean skillFlight(LivingEntity player) {
+        if (!resolved) {
+            resolved = true;
+            if (ModList.get().isLoaded("oxyrpg")) {
+                try {
+                    canFly = Class.forName("dev.emersonoxy.rpg.RpgAviary")
+                        .getMethod("canFly", LivingEntity.class);
+                } catch (ReflectiveOperationException e) {
+                    DoABarrelRoll.LOGGER.warn("Oxy RPG flight integration unavailable", e);
+                }
+            }
+        }
+        if (canFly == null) return false;
+        try { return Boolean.TRUE.equals(canFly.invoke(null, player)); }
+        catch (ReflectiveOperationException e) {
+            canFly = null;
+            DoABarrelRoll.LOGGER.warn("Oxy RPG flight integration disabled", e);
+            return false;
+        }
+    }
+}
